<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tmax</AssemblyName>
    <RootNamespace>Tmax.App</RootNamespace>
    <!-- No console window on Windows; plain executable elsewhere. -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <Version>0.1.0</Version>
    <!-- GitHub repo whose releases the app updates from, e.g. -p:TmaxUpdateRepo=https://github.com/owner/tmax.net -->
    <FrontendDir>$(MSBuildThisFileDirectory)..\..\frontend\</FrontendDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tmax.Core\Tmax.Core.csproj" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TmaxUpdateRepo" Value="$(TmaxUpdateRepo)" />
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The React frontend is built by Vite into frontend/dist and served by Kestrel from wwwroot.
    Pass -p:SkipFrontend=true when iterating on the backend only (or when using TMAX_DEV_URL).
  -->
  <!--
    Plain copy instead of Content items: the Web SDK's static-web-assets pipeline only sees files
    that exist at evaluation time and rejects ones injected later.
  -->
  <Target Name="BuildFrontend" AfterTargets="Build" Condition="'$(SkipFrontend)' != 'true'">
    <Exec Command="node --version" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NodeVersion" />
      <Output TaskParameter="ExitCode" PropertyName="_NodeExit" />
    </Exec>
    <PropertyGroup>
      <_NodeMajor Condition="'$(_NodeExit)' == '0'">$([System.Text.RegularExpressions.Regex]::Match('$(_NodeVersion)', '\d+').Value)</_NodeMajor>
    </PropertyGroup>
    <Error Condition="'$(_NodeExit)' != '0'" Text="Node.js was not found on PATH. The frontend needs Node.js 20 or newer (or build with -p:SkipFrontend=true)." />
    <Error Condition="'$(_NodeExit)' == '0' And $(_NodeMajor) &lt; 20" Text="Node.js $(_NodeVersion) is too old; the frontend needs Node.js 20 or newer (e.g. 'nvm use 22')." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(FrontendDir)" Condition="!Exists('$(FrontendDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" />
    <ItemGroup>
      <_FrontendFiles Include="$(FrontendDir)dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(_FrontendFiles)" DestinationFiles="@(_FrontendFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishFrontend" AfterTargets="Publish">
    <ItemGroup>
      <_FrontendPublishFiles Include="$(OutDir)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendPublishFiles)" DestinationFiles="@(_FrontendPublishFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
